<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ObjectRuntimeSource)" Condition="'$(ObjectRuntimeSource)' != ''" />
    <Compile Include="../../Standalone/FireURQ/src/Runtime/TGPBitmap.cs" />
  </ItemGroup>
  <Target Name="CheckObjectRuntime" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(ObjectRuntimeSource)')" Text="Set ObjectRuntimeSource to the generated __runtime/TObject.cs file." />
  </Target>
</Project>
